// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SymbolType {
	Stock
	ETF
	Futures
	Forex
	Commodity
	Crypto
	Security
}

enum OrderType {
	BUY
	SELL
}

model Symbol {
	id Int @id @default(autoincrement())

	name String @unique
	type SymbolType

	description String @default("") @db.Text

	trades Trade[]
	label Label?

	journalCharts JournalChart[]
	journalTrades JournalTrade[]
}

model Trade {
	id Int @id @default(autoincrement())

	target Decimal?
	stop   Decimal
	pnl    Decimal?

	description String @default("") @db.Text

	labels TradeLabel[]
	orders Order[]
	charts Chart[]

	symbolId Int
	symbol   Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

	journalTrade JournalTrade?

	deleted Boolean @default(false)

	@@index([symbolId])
}

model Order {
	id Int @id @default(autoincrement())

	quantity Int
	date     DateTime
	price    Decimal
	type     OrderType

	tradeId Int
	trade   Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
}

model Label {
	id Int @id @default(autoincrement())

	name   String @unique
	trades TradeLabel[]
	journalTrades JournalTradeLabel[]

	symbolId Int?  @unique
	symbol Symbol? @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  descendants LabelClosure[] @relation("Ancestor")
  ancestors LabelClosure[] @relation("Descendant")
}

model LabelClosure {
	ancestorId   Int
	descendantId Int
	depth        Int

	ancestor   Label @relation("Ancestor", fields: [ancestorId], references: [id], onDelete: Cascade)
	descendant Label @relation("Descendant", fields: [descendantId], references: [id], onDelete: Cascade)

	@@id([ancestorId, descendantId])
	@@index([descendantId])
}

model Chart {
	id Int @id @default(autoincrement())

	timeframe Int

	start BigInt
	end   BigInt

	lines Json @default("[]")

	tradeId Int
	trade   Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now())

	@@index([tradeId])
}

enum FolderColor {
	Grey
	Yellow
	Orange
	Red
}

model NewsEvent {
	id Int @id @default(autoincrement())
	name String

	date DateTime @db.Timestamptz(3)
	allDay Boolean @default(false)

	folderColor FolderColor
	currencies  String[] @default([])

	source String?
	metadata Json?

	@@index([date])
}

model TradeLabel {
	tradeId Int
	labelId Int

	trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
	label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

	@@id([tradeId, labelId])
	@@map("trade_labels")
}

model JournalTradeLabel {
	tradeId Int
	labelId Int

	trade JournalTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
	label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

	@@id([tradeId, labelId])
	@@map("JournalTradeLabel")
}

model JournalEntry {
	id Int @id @default(autoincrement())

	title String @unique

	from DateTime
	to DateTime

	content String @default("") @db.Text

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	charts JournalChart[]
	trades JournalTrade[]
}

model JournalTrade {
	id Int @id @default(autoincrement())

	target Decimal?
	stop Decimal

	pnl Decimal

	journalEntryId Int
	symbolId Int

	orders JournalOrder[]
	labels JournalTradeLabel[]

	tradeId Int? @unique
	trade Trade? @relation(fields: [tradeId], references: [id], onDelete: SetNull)

	journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
	symbol       Symbol       @relation(fields: [symbolId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}

model JournalOrder {
	id Int @id @default(autoincrement())

	quantity Int
	date     DateTime
	price    Decimal
	type     OrderType

	tradeId Int

	trade   JournalTrade @relation(fields: [tradeId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}

model JournalChart {
	id Int @id @default(autoincrement())

	timeframe Int
	ord Int

	start BigInt
	end   BigInt

	objects Json @default("{}")

	journalEntryId Int
	journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

	symbolId Int
	symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
}